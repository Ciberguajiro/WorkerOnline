# GitHub Personal Access Token (para clonar repos privados)
# Genera uno en: https://github.com/settings/tokens
# Necesita permisos: repo (para repos privados)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# API Key para Claude Code (Anthropic)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api-xx-xxxxxxxxx

# API Key para OpenAI / opencode
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxx

# Puerto del servidor (default: 3000)
PORT=3000

# Node environment: development | production
NODE_ENV=production

# --- Seguridad (opcional, por implementar) ---
# JWT_SECRET=tu-secreto-jwt-super-seguro
# SESSION_TIMEOUT=3600

# --- Logging (opcional) ---
# LOG_LEVEL=info
# LOG_PRETTY=true

# --- Rate Limiting (opcional) ---
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
